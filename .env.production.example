# GradConnect production settings — for the VPS only. DEPLOY-HOSTINGER.md
# walks through every value. On the server:
#
#   cp .env.production.example .env
#   nano .env
#
# Never commit the filled-in .env; it holds the server's secrets.

# Makes plain `docker compose ...` use the production stack on the server.
COMPOSE_FILE=docker-compose.prod.yml

APP_NAME=GradConnect
APP_ENV=production
APP_DEBUG=false
# Generate once with:  echo "base64:$(openssl rand -base64 32)"
# Then never change it: it encrypts sessions and stored secrets.
APP_KEY=

# Your domain, e.g. gradconnect.example.com. The server gets an HTTPS
# certificate for it automatically. Before the domain points at the VPS,
# use SERVER_NAME=:80 and APP_URL=http://<your VPS IP> (no HTTPS).
SERVER_NAME=gradconnect.example.com
APP_URL=https://gradconnect.example.com

# Only `true` when the site is on HTTPS; set it to false on plain HTTP,
# or nobody will be able to stay signed in.
SESSION_SECURE_COOKIE=true

# The database runs in its own container and is never exposed publicly.
# Choose a long random password:  openssl rand -hex 24
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=gradconnect
DB_USERNAME=gradconnect
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Roles, colleges and skills only. Never `true` on a public server: the
# demo accounts all use the password "password".
SEED_DEMO_DATA=false

# ── Email ─────────────────────────────────────────────────────────────
# New graduates must confirm their email address before they can sign in,
# so this has to work. With a Hostinger email account (hPanel → Emails):
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@gradconnect.example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@gradconnect.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AI matching ──────────────────────────────────────────────────────
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_DIM=768
AI_SCORING_PROVIDER=groq
AI_SCORING_FALLBACK=gemini

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
